import "std/math" as math

let g = 1.0
let dt = 0.002
let steps = 400.0

let m1 = 1.0
let m2 = 0.12
let m3 = 12.0

let x1 = -1.2
let y1 = 0.0
let vx1 = 0.0
let vy1 = -0.8

let x2 = 0.0
let y2 = 0.0
let vx2 = 0.0
let vy2 = 1.1

let x3 = 1.0
let y3 = 0.0
let vx3 = 0.0
let vy3 = -0.1

func cube(v) => v * v * v
func dist(dx, dy) => math.sqrt(dx * dx + dy * dy + 1.0)

func step(i, x1, y1, vx1, vy1, x2, y2, vx2, vy2, x3, y3, vx3, vy3) {
  if(i >= steps, [
    [x1, y1],
    [x2, y2],
    [x3, y3],
    0.5 * m1 * math.sqrt(vx1 * vx1 + vy1 * vy1) * math.sqrt(vx1 * vx1 + vy1 * vy1) +
    0.5 * m2 * math.sqrt(vx2 * vx2 + vy2 * vy2) * math.sqrt(vx2 * vx2 + vy2 * vy2) +
    0.5 * m3 * math.sqrt(vx3 * vx3 + vy3 * vy3) * math.sqrt(vx3 * vx3 + vy3 * vy3) +
    -g * m1 * m2 / dist(x2 - x1, y2 - y1) +
    -g * m1 * m3 / dist(x3 - x1, y3 - y1) +
    -g * m2 * m3 / dist(x3 - x2, y3 - y2)
  ], {
    let dx12 = x2 - x1
    let dy12 = y2 - y1
    let dx13 = x3 - x1
    let dy13 = y3 - y1
    let dx23 = x3 - x2
    let dy23 = y3 - y2

    let r12 = dist(dx12, dy12)
    let r13 = dist(dx13, dy13)
    let r23 = dist(dx23, dy23)

    let inv12 = 1.0 / cube(r12)
    let inv13 = 1.0 / cube(r13)
    let inv23 = 1.0 / cube(r23)

    let ax1 = g * m2 * dx12 * inv12 + g * m3 * dx13 * inv13
    let ay1 = g * m2 * dy12 * inv12 + g * m3 * dy13 * inv13
    let ax2 = g * m1 * (-dx12) * inv12 + g * m3 * dx23 * inv23
    let ay2 = g * m1 * (-dy12) * inv12 + g * m3 * dy23 * inv23
    let ax3 = g * m1 * (-dx13) * inv13 + g * m2 * (-dx23) * inv23
    let ay3 = g * m1 * (-dy13) * inv13 + g * m2 * (-dy23) * inv23

    step(
      i + 1.0,
      x1 + (vx1 + ax1 * dt) * dt,
      y1 + (vy1 + ay1 * dt) * dt,
      vx1 + ax1 * dt,
      vy1 + ay1 * dt,
      x2 + (vx2 + ax2 * dt) * dt,
      y2 + (vy2 + ay2 * dt) * dt,
      vx2 + ax2 * dt,
      vy2 + ay2 * dt,
      x3 + (vx3 + ax3 * dt) * dt,
      y3 + (vy3 + ay3 * dt) * dt,
      vx3 + ax3 * dt,
      vy3 + ay3 * dt
    )
  })
}

emit step(0.0, x1, y1, vx1, vy1, x2, y2, vx2, vy2, x3, y3, vx3, vy3)
