import "std/math" as math

let mu = 3.986004418e14
let earthRadius = 6371000.0
let samples = 96.0
let altitude = 160000.0
let step = 250000.0

func cube(v) => v * v * v
func escape(r) => math.sqrt(2.0 * mu / r)
func period(r) => 2.0 * math.pi * math.sqrt(cube(r) / mu)

func sweep(i, alt, sumEscape, sumPeriod, maxEscape) {
  if(i >= samples, [
    sumEscape / samples,
    sumPeriod / samples,
    maxEscape,
    escape(earthRadius + 400000.0)
  ], {
    let r = earthRadius + alt
    let esc = escape(r)
    let per = period(r)
    sweep(
      i + 1.0,
      alt + step,
      sumEscape + esc,
      sumPeriod + per,
      if(esc > maxEscape, esc, maxEscape)
    )
  })
}

emit sweep(0.0, altitude, 0.0, 0.0, 0.0)
